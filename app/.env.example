# Copy to .env (gitignored) and fill in real values. Placeholders only here.

# HTTP port
PORT=3000

# Admin API token for POST/PATCH /api/posts* and /api/admin/*.
# Unset = admin endpoints answer 503.
ADMIN_TOKEN=<choose-a-long-random-token>

# Event store selection: 'postgres' uses DATABASE_URL; anything else (or
# unset) uses the JSONL file store at BLOG_EVENTS_PATH.
EVENT_STORE=postgres
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>

# File store location (only used when EVENT_STORE is not 'postgres')
#BLOG_EVENTS_PATH=./var/blog-events.jsonl

# Content/theme directories (defaults resolve to ../content and ../themes)
#CONTENT_DIR=
#THEMES_DIR=

# Authored page Markdown seed files (default resolves to ../content/pages)
#PAGES_DIR=

# GitHub API token for the repo cards (/api/github/*). Optional: unset means
# unauthenticated calls (60 req/hour, public repos only), which is usually
# enough. WARNING: a token with private-repo scope makes PRIVATE repo metadata
# public on the site — use a fine-grained, READ-ONLY, public-repo-only PAT.
#GITHUB_TOKEN=<fine-grained-read-only-pat>

# Deploy stamping (normally injected by the build pipeline)
#GIT_SHA=
#BUILD_TIME=
